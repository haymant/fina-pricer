{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PricingRequest",
  "type": "object",
  "required": ["InstrumentKey", "UnwindMapRaw", "RiskFactorKeys", "MarketDataSnapshot", "UpdatedLifecycle", "parameters"],
  "properties": {
    "InstrumentKey": {"$ref": "instrument_key.schema.json"},
    "UnwindMapRaw": {"$ref": "unwind_map_raw.schema.json"},
    "RiskFactorKeys": {"type": "array", "minItems": 1, "items": {"$ref": "risk_factor_key.schema.json"}},
    "MarketDataSnapshot": {"$ref": "market_data_snapshot.schema.json"},
    "UpdatedLifecycle": {"$ref": "updated_lifecycle.schema.json"},
    "parameters": {
      "type": "object",
      "required": ["eval_datetime", "expiry"],
      "properties": {
        "eval_datetime": {"type": "string", "format": "date"},
        "expiry": {"type": "string", "format": "date"},
        "option_type": {"enum": ["call", "put"]},
        "payoff_type": {"enum": ["vanilla", "barrier", "autocall", "fcn"]},
        "barriers": {"type": "array", "items": {"type": "object", "properties": {"direction": {"enum": ["up", "down"]}, "event": {"enum": ["KI", "KO"]}, "level": {"type": "number", "exclusiveMinimum": 0}, "level_type": {"enum": ["relative_initial", "absolute"], "default": "relative_initial"}, "monitoring": {"enum": ["global", "local"]}, "observation_dates": {"type": "array", "items": {"type": "string"}}, "rebate": {"type": "number"}}, "additionalProperties": true}},
        "accrual": {"type": ["object", "null"]},
        "risk_free_rate": {"type": "number"},
        "dividend_yield": {"type": "number"},
        "volatility": {"type": "number", "exclusiveMinimum": 0},
        "svi": {"type": ["object", "null"], "properties": {"a": {"type": "number", "exclusiveMinimum": 0}, "b": {"type": "number", "exclusiveMinimum": 0}, "rho": {"type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 1}, "m": {"type": "number"}, "sigma": {"type": "number", "exclusiveMinimum": 0}}, "required": ["a", "b", "rho", "m", "sigma"], "additionalProperties": false},
        "paths": {"type": "integer", "minimum": 1000},
        "steps": {"type": "integer", "minimum": 2},
        "seed": {"type": "integer"},
        "bump_size": {"type": "number", "exclusiveMinimum": 0, "default": 0.01},
        "bump_mode": {"enum": ["relative", "absolute"]},
        "currency_conversion": {"type": "number", "exclusiveMinimum": 0},
        "smooth_barrier": {"type": "boolean", "default": false},
        "barrier_smoothing_width": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.25, "default": 0.01},
        "basket_method": {"enum": ["worst_of", "best_of"], "default": "worst_of"},
        "correlation": {"type": ["array", "null"], "items": {"type": "array", "items": {"type": "number"}}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
