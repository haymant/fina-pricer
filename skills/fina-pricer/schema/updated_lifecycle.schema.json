{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpdatedLifecycle",
  "type": "object",
  "required": ["instrument_state", "applied_fixings", "adjusted_underlyings"],
  "properties": {
    "instrument_state": {"type": "string"},
    "applied_fixings": {"type": "array", "items": {"type": "string", "format": "date"}},
    "adjusted_underlyings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "adjustment_factor"],
        "properties": {
          "name": {"type": "string"},
          "adjustment_factor": {"type": "number", "exclusiveMinimum": 0}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}